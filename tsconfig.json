{
  // 只给编辑器与类型检查用，构建由 vitepress 自己的 vite 完成
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["node", "vitepress/client"]
  },
  "include": ["docs/.vitepress/**/*.ts", "docs/.vitepress/**/*.mts", "docs/.vitepress/**/*.vue"],
  "exclude": ["docs/.vitepress/cache", "docs/.vitepress/dist"]
}
